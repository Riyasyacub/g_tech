<div class="m-5 flex justify-between">
  <div>
    <%= form_with(url: enquiries_path, method: :get) do |f| %>
      <%= f.text_field :query, value: params[:query], class: "w-32" %>
      <%= f.date_field :start_date, value: @start_date, class: "w-32" %>
      <%= f.date_field :end_date, value: @end_date, max: Date.today, class: "w-32" %>
      <%= f.submit "Search", class: "text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800" %>
      <%= link_to "Reset", enquiries_path, class: "text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800" %>
    <% end %>
  </div>
  <div class="flex justify-end">
    <%= link_to "New Enquiry", new_enquiry_path, class: "text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800" %>
    <%= link_to "Students", students_path, class: "text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800" %>
  </div>
</div>

<% headers = ['Name', 'Course', 'Estimated Fees', "Referred By", "Action"] %>

<% if current_user.admin? %>
  <div class="text-sm font-medium text-center text-gray-500 border-b border-gray-200 dark:text-gray-400 dark:border-gray-700">
    <ul class="flex flex-wrap -mb-px">
      <% cls = "inline-block p-4 border-b-2 border-transparent rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300" %>
      <% active_cls = "inline-block p-4 text-blue-600 border-b-2 border-blue-600 rounded-t-lg active dark:text-blue-500 dark:border-blue-500" %>

      <li class="me-2">
        <%= link_to "All", enquiries_path(query: params[:query], start_date: params[:start_date], end_date: params[:end_date]), class: params[:user_id].blank? ? active_cls : cls %>
      </li>
      <% User.non_admin.each do |user| %>
        <li class="me-2">
          <%= link_to user.name, enquiries_path(user_id: user, query: params[:query], start_date: params[:start_date], end_date: params[:end_date]), class: params[:user_id] == user.id.to_s ? active_cls : cls %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<div id="detailed-pricing" class="w-full overflow-x-auto">
  <div class="overflow-hidden min-w-max">
    <div class="w-full flex p-4 text-sm font-medium text-gray-900 bg-gray-100 border-t border-b border-gray-200 dark:bg-gray-800 dark:border-gray-700 dark:text-white">
      <% headers.each do |h| %>
        <div class="w-1/5 flex items-center"><%= h %></div>
      <% end %>
      <div style="width: 20px;"></div>
    </div>

    <% @enquiries.each do |enquiry| %>
      <%= turbo_frame_tag "enquiry_#{enquiry.id}", data: { controller: 'slider' } do %>
        <div class="w-full flex bg-white border-b dark:bg-gray-800 dark:border-gray-700 text-gray-500 dark:text-gray-400">

          <div class="px-6 py-4 w-1/5"><%= link_to enquiry.name, enquiry_path(enquiry), data: { turbo: false } %></div>
          <div class="px-6 py-4 w-1/5"><%= enquiry.course&.name %></div>
          <div class="px-6 py-4 w-1/5"><%= enquiry.estimated_fees %></div>
          <div class="px-6 py-4 w-1/5"><%= enquiry.referred_by %></div>
          <div class="px-6 py-4 w-1/5">
            <%= link_to "Convert to Student", new_student_path(enquiry_id: enquiry), data: { turbo: false } %>
          </div>
        </div>
        <%= turbo_frame_tag "enquiry_details_#{enquiry.id}", data: { slider_target: 'target_element' } do %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
